{
  "name": "particle-academy/stripe-php",
  "description": "Stripe for PHP — the service descriptor, its faker, its webhook verification, and one class per operation. Plain HTTP on particle-academy/fancy-connector-core; no vendor SDK.",
  "type": "library",
  "keywords": [
    "stripe",
    "payments",
    "connector",
    "api",
    "fancy-ui",
    "particle-academy"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Fancy-Friends/stripe",
  "support": {
    "issues": "https://github.com/Fancy-Friends/stripe/issues",
    "source": "https://github.com/Fancy-Friends/stripe"
  },
  "authors": [
    {
      "name": "Particle Academy",
      "homepage": "https://github.com/Particle-Academy"
    }
  ],
  "require": {
    "php": "^8.4",
    "particle-academy/fancy-connector-core": ">=0.3.0 <2.0"
  },
  "require-dev": {
    "laravel/pint": "^1.26",
    "pestphp/pest": "^3.0|^4.0"
  },
  "autoload": {
    "psr-4": {
      "ParticleAcademy\\Stripe\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ParticleAcademy\\Stripe\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "pest",
    "lint": "pint --test"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
