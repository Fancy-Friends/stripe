{
  "name": "particle-academy/stripe-php",
  "description": "Stripe for PHP — the service descriptor, its faker, its webhook verification, one class per operation, and a fancy-flow-php executor per node. Plain HTTP on particle-academy/fancy-connector-core; no vendor SDK.",
  "type": "library",
  "keywords": [
    "stripe",
    "payments",
    "connector",
    "api",
    "fancy-ui",
    "particle-academy"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Fancy-Friends/stripe",
  "support": {
    "issues": "https://github.com/Fancy-Friends/stripe/issues",
    "source": "https://github.com/Fancy-Friends/stripe"
  },
  "authors": [
    {
      "name": "Particle Academy",
      "homepage": "https://github.com/Particle-Academy"
    }
  ],
  "require": {
    "php": "^8.4",
    "particle-academy/fancy-connector-core": ">=0.9.0 <2.0"
  },
  "require-dev": {
    "laravel/framework": "^13.0",
    "laravel/pint": "^1.26",
    "pestphp/pest": "^5.0"
  },
  "suggest": {
    "particle-academy/fancy-flow-php": ">=0.51.0 <2.0 — runs this connector's nodes on a fancy-flow-php host (src/Flow/). Everything outside Flow\\ works without it.",
    "laravel/framework": "^13.0 — the Laravel integration (src/Laravel/): a service provider, config, verified webhook routes, and Stripe::fake(). Everything outside Laravel\\ works without it."
  },
  "conflict": {
    "particle-academy/fancy-flow-php": "<0.51.0 || >=2.0"
  },
  "autoload": {
    "psr-4": {
      "ParticleAcademy\\Stripe\\": "packages/php/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ParticleAcademy\\Stripe\\Tests\\": "packages/php/tests/"
    }
  },
  "scripts": {
    "test": "pest --test-directory=packages/php/tests",
    "lint": "find packages/php -name '*.php' -print0 | xargs -0 -n1 php -l",
    "format": "pint"
  },
  "extra": {
    "laravel": {
      "providers": [
        "ParticleAcademy\\Stripe\\Laravel\\StripeServiceProvider"
      ],
      "aliases": {
        "Stripe": "ParticleAcademy\\Stripe\\Laravel\\Stripe"
      }
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
